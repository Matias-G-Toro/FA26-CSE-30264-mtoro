def init_auth(authlist):
    authlist_path = Path("authlists")
    authlist_path /= authlist

    # use obj = pathlib.path("scansets")
    """load id-auth pairs into "auths" dict from CSV file"""
    auths = dict()
    with open(authlist_path, "r") as authlist_file:
        authlist_reader = csv.reader(authlist_file)
        for row in authlist_reader:
            if row[0][0] != '#' and row[0] in auths: 
                auths[row[0]] = row[1] 
            if row[0] in auths:
                print("ids must be unique",file=sys.stderr)
                sys.exit(1)
    print(auths)
    return auths

