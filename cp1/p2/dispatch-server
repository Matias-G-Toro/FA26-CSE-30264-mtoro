def parse_arguments():
    
    desc= """dispatch-server [OPTIONS]
    -p, --port PORT
        override the default port 54000 (between 54000 and 54150)
    -a, --auth FILE
        override the default input csv file for authorization
    -s, --scansets FILE
        override the specified JSON file
    """
    parser = argparse.ArgumentParser(
        prog='dispatch-server',
        description='securely serve a json file up over UDP', 
        epilog=desc
    )

    parser.add_argument("-p", "--port",
        default=54000,
        type=int,
        help="override the default port 54000 (between 54000 and 54150)"
    ) 
    parser.add_argument("-a", "--auth",
        default="auth1.csv",
        type=str,
        choices=os.listdir("authlists"),
        help="select input csv file from ./authlists/ (default is 'auth1.csv')"
    )
    parser.add_argument("-s", "--scansets",
        default="scan.json",
        type=str,
        choices=os.listdir("scansets"),
        help="select JSON file from ./scansets/ (default is 'scan.json')"
    ) 

    args = parser.parse_args()
    if args.port < 54000 or args.port > 54150:
        print("port must be between 54000 and 54150!", file=sys.stderr)
        sys.exit(2)

    return args

